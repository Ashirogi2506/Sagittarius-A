  "sceneDialogue": [
    {
      "trigger": "garage_first_open",
      "lines": [
        {
          "speaker": "{playerName}",
          "line": "Leave room for the laser cutter?"
        },
        {
          "speaker": "Sam - Flight Engineer",
          "line": "The laser can free a jammed cover in seconds, if the ship can power it. With the hand tools, it'll just take a little longer."
        }
      ]
    },
    {
      "trigger": "required_cargo_secured",
      "lines": [
        {
          "speaker": "Sam - Flight Engineer",
          "line": "Both locks are green. That panel stays where you put it when the engines light."
        }
      ]
    },
    {
      "trigger": "laser_overload",
      "lines": [
        {
          "speaker": "Sam - Flight Engineer",
          "line": "The laser pushed us over the power limit. Its breaker tripped. Cabin and radio are still on."
        },
        {
          "speaker": "Sam - Flight Engineer",
          "line": "We can swap the power system here or leave the laser off and open the cover by hand on the Moon."
        }
      ]
    },
    {
      "trigger": "landing_map_first_open",
      "lines": [
        {
          "speaker": "{playerName}",
          "line": "Beacon Pad is right beside the base. Why did Khulan mark a second one?"
        },
        {
          "speaker": "Sam - Flight Engineer",
          "line": "Ridge Pad stays lit longer. We'll spend more fuel getting there and carry the panel farther, but it's there if we miss the Beacon window."
        }
      ]
    },
    {
      "trigger": "orbit_reached",
      "lines": [
        {
          "speaker": "Earth Flight Control",
          "line": "Commander {playerName}, you're in orbit. Both repair items are secure. Pole-7 is listening on the backup channel."
        },
        {
          "speaker": "{playerName}",
          "line": "Khulan, we've got your panel and both locks are green. See you on the Moon."
        }
      ]
    }
  ],
