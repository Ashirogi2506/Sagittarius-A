  "opening": [
    {
      "speaker": "Khulan - Pole-7",
      "line": "Commander {playerName}, this is Khulan at Pole-7. Can you hear me? I'm calling from the backup radio."
    },
    {
      "speaker": "{playerName}",
      "line": "We hear you, Khulan. What's happened?"
    },
    {
      "speaker": "Khulan - Pole-7",
      "line": "Our main power panel burned out. The crew is safe, but our beacons and main relay are down. I can talk to you from here. I can't guide you from the pad."
    },
    {
      "speaker": "{playerName}",
      "line": "We're still loading. Tell me what to bring."
    },
    {
      "speaker": "Khulan - Pole-7",
      "line": "A P-4 panel and an insulated repair kit. I'm sending our last route map. There's a cart at the pad. Use it for the panel and check the road before you take it through."
    },
    {
      "speaker": "Sam - Flight Engineer",
      "line": "Three cargo spaces for the panel and kit. I had plans for those spaces. The snack budget will recover."
    },
    {
      "speaker": "{playerName}",
      "line": "Put both on the checklist. We'll call again once we're in orbit."
    }
  ],
